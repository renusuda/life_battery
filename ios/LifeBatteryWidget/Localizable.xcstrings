    "widget.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرف ما تبقّى من عمرك بنظرة سريعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বাকি জীবন এক নজরে দেখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See your remaining life at a glance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu vida restante de un vistazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre vie restante d’un coup d’œil."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારું બાકી જીવન એક નજરમાં જુઓ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כמה נותר מהחיים, במבט אחד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना बचा हुआ जीवन एक नज़र में देखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat sisa hidup Anda sekilas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残りの人生をひと目で確認"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಉಳಿದ ಜೀವನವನ್ನು ಒಂದೇ ನೋಟದಲ್ಲಿ ನೋಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남은 인생을 한눈에 확인하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ശേഷിക്കുന്ന ജീവിതം ഒറ്റനോട്ടത്തിൽ കാണൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उरलेले आयुष्य एका नजरेत पाहा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat baki hidup anda dengan sekali pandang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je resterende leven in één oogopslag."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ବାକି ଜୀବନ ଏକ ନଜରରେ ଦେଖନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੀ ਬਾਕੀ ਜ਼ਿੰਦਗੀ ਇੱਕ ਨਜ਼ਰ ਵਿੱਚ ਦੇਖੋ।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua vida restante de relance."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставшаяся жизнь с одного взгляда."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீதமுள்ள வாழ்நாளை ஒரே பார்வையில் பாருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మిగిలిన జీవితాన్ని ఒక్క చూపులో చూడండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูชีวิตที่เหลืออยู่ได้ในพริบตา"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "باقی زندگی، ایک نظر میں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem nhanh quãng đời còn lại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼看到余生还剩多少"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼看出餘生還剩多少"
          }
        }
      }
    },
