    "widget.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See your remaining life at a glance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu vida restante de un vistazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre vie restante d’un coup d’œil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना बचा हुआ जीवन एक नज़र में देखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat sisa hidup Anda sekilas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残りの人生をひと目で確認"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat baki hidup anda dengan sekali pandang."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua vida restante de relance."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставшаяся жизнь с одного взгляда."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูชีวิตที่เหลืออยู่ได้ในพริบตา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem nhanh quãng đời còn lại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼看到余生还剩多少"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼看出餘生還剩多少"
          }
        }
      }
    },
