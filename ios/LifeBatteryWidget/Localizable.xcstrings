        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูชีวิตที่เหลืออยู่ได้ในพริบตา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem nhanh quãng đời còn lại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼看到余生还剩多少"
